
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: linear-gradient(135deg, #fff8fc, #f2eaff);
  font-family: 'DM Sans', sans-serif;
}

.auth-card {
  width: 100%;
  max-width: 430px;
  padding: 38px;
  background: white;
  border-radius: 24px;
  box-shadow: 0 15px 50px rgba(103, 61, 145, 0.12);
  text-align: center;
  box-sizing: border-box;
}

.auth-logo {
  width: 65px;
  height: 65px;
  display: grid;
  place-items: center;
  margin: 0 auto 18px;
  border-radius: 20px;
  background: linear-gradient(135deg, #8951c9, #eb79ad);
  color: white;
  font-size: 34px;
}

.auth-card h1 {
  color: #58317f;
  font-size: 23px;
  font-weight: 800;
  margin: 0;
}

.auth-subtitle {
  color: #999;
  margin: 9px 0 25px;
}

.auth-tabs {
  display: flex;
  padding: 5px;
  background: #f7f1fc;
  border-radius: 12px;
  margin-bottom: 25px;
}

.auth-tabs button {
  flex: 1;
  border: none;
  padding: 12px;
  border-radius: 9px;
  background: transparent;
  color: #777;
  cursor: pointer;
  font-weight: 600;
}

.auth-tabs button.active {
  background: white;
  color: #8951c9;
}

.auth-card form {
  display: flex;
  flex-direction: column;
  gap: 17px;
  text-align: left;
}

.auth-card label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #554b5e;
  font-size: 13px;
  font-weight: 600;
}

.auth-card input {
  width: 100%;
  box-sizing: border-box;
  padding: 14px;
  border: 1px solid #eadff2;
  border-radius: 11px;
  outline: none;
  font-size: 14px;
}

.auth-card input:focus {
  border-color: #8951c9;
}

.auth-submit {
  width: 100%;
  padding: 15px;
  border: none;
  border-radius: 11px;
  background: linear-gradient(100deg, #8951c9, #d86ca8);
  color: white;
  font-weight: 700;
  font-size: 15px;
  cursor: pointer;
}

.auth-submit:disabled {
  opacity: 0.6;
}

.auth-error {
  color: #d13b56;
  font-size: 13px;
}

.auth-message {
  color: #26834c;
  font-size: 13px;
}

.auth-footer {
  color: #999;
  font-size: 11px;
  line-height: 1.6;
  margin-top: 24px;
}

.auth-loading {
  min-height: 100vh;
  display: grid;
  place-items: center;
  color: #8951c9;
}

.auth-account-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 12px 20px;
  background: #f7f1fc;
  color: #58317f;
  font-size: 13px;
}

.auth-account-bar button {
  border: none;
  border-radius: 8px;
  padding: 9px 15px;
  background: #8951c9;
  color: white;
  cursor: pointer;
}

@media (max-width: 480px) {
  .auth-card {
    padding: 28px 22px;
  }

  .auth-card h1 {
    font-size: 20px;
  }
}

